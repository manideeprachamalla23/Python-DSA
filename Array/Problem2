<!-- At a bridal mehndi studio in Jaipur, artists digitize their intricate henna patterns using a specialized scanner. The designs are stored as rectangular grids where each cell holds an ink density value. For the pattern library software, designs must be read in a spiral order - starting from the outer border and moving inward.The scanner reads clockwise: right along the top edge, down the right edge, left along the bottom, up the left edge, then continues spiraling inward. This traversal order is essential for the compression algorithm used in the studio's design database.Given an m×n matrix representing a mehndi pattern, return all elements in spiral order (clockwise from outside to inside)
 -->


class Solution:
    def spiralOrder(self, matrix: list[list[int]]) -> list[int]:
        # start your solution
        if not matrix or not matrix[0]:
            return []

        m = len(matrix)
        n = len(matrix[0])

        top = 0
        bottom = m - 1
        left = 0
        right = n - 1

        result = []

        while top <= bottom and left <= right:
            for j in range(left, right + 1):
                result.append(matrix[top][j])
            top += 1

            for i in range(top, bottom + 1):
                result.append(matrix[i][right])
            right -= 1

            if top <= bottom:
                for j in range(right, left - 1, -1):
                    result.append(matrix[bottom][j])
                bottom -= 1

            if left <= right:
                for i in range(bottom, top - 1, -1):
                    result.append(matrix[i][left])
                left += 1

        return result # <--- THIS MUST BE OUTSIDE while, aligned with while
        # end your solution

def main():
    m, n = map(int, input().split())
    matrix = []
    for _ in range(m):
        row = list(map(int, input().split()))
        matrix.append(row)

    sol = Solution()
    result = sol.spiralOrder(matrix)

    print(' '.join(map(str, result)))

if __name__ == "__main__":
    main()